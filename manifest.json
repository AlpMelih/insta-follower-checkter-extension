{
  "manifest_version": 3,
  "name": "Instagram Takipçi Analiz",
  "version": "1.0",
  "description": "Seni takip etmeyenleri tespit et!",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "host_permissions": [
    "https://www.instagram.com/*"
  ]
}
